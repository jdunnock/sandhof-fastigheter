---
import Layout from '../../layouts/Layout.astro'
import { properties, getProperty } from '../../content/properties'

export function getStaticPaths() {
  return properties.map(p => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
const property = getProperty(slug)
if (!property) return Astro.redirect('/fastigheter')

const apiBase = import.meta.env.PUBLIC_DELLMANDER_API_URL ?? ''
const heroSrc = property.heroImage
  ? `${apiBase}/api/gallery-images/${property.heroImage}`
  : '/images/placeholder-property.jpg'
---

<Layout title={property.name} description={property.description}>
  <!-- Hero image -->
  <div class="w-full h-64 sm:h-96 bg-stone-100 overflow-hidden">
    <img src={heroSrc} alt={property.name} class="w-full h-full object-cover" />
  </div>

  <article class="max-w-3xl mx-auto px-6 py-12">
    <a href="/fastigheter" class="text-sm text-stone-400 hover:text-stone-600 mb-6 inline-block">
      ← Alla fastigheter
    </a>
    <p class="text-xs uppercase tracking-widest text-stone-400 mb-2">
      {property.address}{property.apartments > 0 ? ` · ${property.apartments} lgh` : ''}
    </p>
    <h1 class="text-3xl sm:text-4xl font-semibold text-stone-900 mb-6">{property.name}</h1>
    <p class="text-stone-600 text-lg leading-relaxed mb-8">{property.longDescription || property.description}</p>

    {property.features.length > 0 && (
      <div class="mb-10">
        <h2 class="font-semibold text-stone-900 mb-4">Fastighetens egenskaper</h2>
        <ul class="space-y-2">
          {property.features.map(f => (
            <li class="flex items-center gap-2 text-stone-600 text-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-stone-400 flex-shrink-0"></span>
              {f}
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Gallery -->
    {property.galleryImages.length > 0 && (
      <div class="grid grid-cols-2 gap-3 mb-12">
        {property.galleryImages.map(img => (
          <img
            src={`${apiBase}/api/gallery-images/${img}`}
            alt={`${property.name} — bild`}
            class="rounded aspect-[4/3] object-cover w-full bg-stone-100"
            loading="lazy"
          />
        ))}
      </div>
    )}

    <!-- CTA -->
    <div class="border-t border-stone-100 pt-10">
      <h2 class="font-semibold text-stone-900 mb-2">Intresserad av att bo här?</h2>
      <p class="text-stone-500 text-sm mb-4">Kontakta oss så berättar vi om lediga lägenheter.</p>
      <a href="/kontakt" class="inline-block px-5 py-2.5 bg-stone-900 text-white text-sm font-medium rounded hover:bg-stone-700 transition-colors">
        Skicka intresseanmälan
      </a>
    </div>
  </article>
</Layout>
