        <ul class="space-y-2">
          {property.features.map(f => (
            <li class="flex items-center gap-2 text-ink-muted text-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-ink-muted flex-shrink-0"></span>
              {f}
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Gallery -->
    {images.length > 1 && (
      <div class="grid grid-cols-2 gap-3 mb-12">
