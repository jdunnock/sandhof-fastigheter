---
import Layout from '../../layouts/Layout.astro'
import PropertyCard from '../../components/PropertyCard.astro'
import { fetchPublicProperties, resolveImageUrl } from '../../lib/images'

const propertiesWithImages = (await fetchPublicProperties()).map(p => ({
  property: p,
  heroImageUrl: p.gallery[0] ? resolveImageUrl(p.gallery[0].url) : '',
}))
---

<Layout title="Fastigheter" description="Sandhof Fastigheter äger och sköter sex fastigheter i Skövde.">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-8">
    <p class="text-xs uppercase tracking-widest text-stone-400 mb-3">Sex fastigheter i Skövde</p>
    <h1 class="text-3xl sm:text-4xl font-semibold text-stone-900 mb-4">Välskötta byggnader med karaktär</h1>
    <p class="text-stone-500 max-w-prose leading-relaxed">
      Vi äger och förvaltar sex centralt belägna fastigheter i Skövde direkt — utan mellanhänder. Varje byggnad sköts med långsiktig omsorg.
    </p>
  </section>
  <section class="max-w-5xl mx-auto px-6 pb-20">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {propertiesWithImages.map(({ property, heroImageUrl }) => <PropertyCard property={property} heroImageUrl={heroImageUrl} />)}
    </div>
  </section>
</Layout>
