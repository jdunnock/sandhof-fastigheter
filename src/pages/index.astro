---
import Layout from '../layouts/Layout.astro'
import PropertyCard from '../components/PropertyCard.astro'
import { fetchPublicProperties, resolveImageUrl } from '../lib/images'

const allProperties = await fetchPublicProperties()
const featuredWithImages = allProperties.slice(0, 3).map(p => ({
  property: p,
  heroImageUrl: p.gallery[0] ? resolveImageUrl(p.gallery[0].url) : '',
}))

const carouselImages = allProperties
  .map(p => ({ name: p.name, url: p.gallery[0] ? resolveImageUrl(p.gallery[0].url) : '' }))
  .filter(img => img.url)

const principles = [
  {
    num: '01',
    title: 'Trivsamma hem',
    text: 'Vi vill att fastigheterna vi äger är platser där folk trivs och vill bo länge. Detaljer spelar roll — inte bara det som syns.',
  },
  {
    num: '02',
    title: 'Löpande underhåll',
    text: 'Vi tar hand om fastigheterna löpande, inte bara när något gått sönder. Det gör att de håller längre och hyresgästerna mår bättre.',
  },
  {
    num: '03',
    title: 'Lång sikt',
    text: 'Med mer än 20 års erfarenhet i branschen tänker vi i decennier. Det påverkar hur vi underhåller, vilka hantverkare vi väljer och hur vi behandlar de som bor hos oss.',
  },
]

const tenantValues = [
  { title: 'Du når oss direkt', text: 'Inte via ett callcenter eller ett ärendesystem. Vi svarar på mail och telefon och känner till varje fastighet.' },
  { title: 'Felanmälningar hanteras snabbt', text: 'Vi anlitar ett fåtal pålitliga hantverkare i Skövde. Det gör att vi kan agera snabbt utan långa led.' },
  { title: 'Välskötta gemensamma ytor', text: 'Trapphus, tvättstugor och källare underhålls regelbundet. Det är en del av att ta ansvar för hela fastigheten.' },
  { title: 'Vi lyssnar', text: 'Om det är något som inte fungerar vill vi veta det. Inte för att det låter bra, utan för att vi faktiskt kan åtgärda det.' },
]
---

<Layout title="Välkommen">
  <!-- Hero Carousel -->
  <div class="relative h-screen overflow-hidden bg-ink" id="hero-carousel">
    {carouselImages.length > 0 ? (
      carouselImages.map((img, i) => (
        <div
          class="carousel-slide absolute inset-0 transition-opacity duration-[1200ms]"
          data-index={String(i)}
          style={i === 0 ? 'opacity:1' : 'opacity:0'}
        >
          <img
            src={img.url}
            alt={img.name}
            class="w-full h-full object-cover"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))
    ) : (
      <div class="absolute inset-0 bg-stone-700"></div>
    )}

    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/75 z-10 pointer-events-none"></div>

    <!-- Text & CTA -->
    <div class="absolute inset-0 z-20 flex flex-col justify-end px-8 pb-16 sm:px-16 sm:pb-20">
      <p class="text-xs uppercase tracking-widest text-white/70 mb-5">Skövde · Sedan 2010</p>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold text-white leading-tight max-w-2xl mb-8">
        Sex fastigheter i Skövde.<br />Förvaltade med omsorg.
      </h1>
      <p class="text-white/80 text-lg max-w-xl mb-10 leading-relaxed hidden sm:block">
        Vi äger och sköter sex centralt belägna fastigheter i Skövde. Med lång erfarenhet och ett personligt engagemang i varje byggnad.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/fastigheter" class="px-6 py-3 bg-white text-ink text-sm font-medium rounded hover:bg-cream transition-colors">
          Våra fastigheter
        </a>
        <a href="/om-oss" class="px-6 py-3 border border-white/50 text-white text-sm font-medium rounded hover:border-white transition-colors">
          Om oss
        </a>
      </div>
    </div>

    <!-- Dot indicators -->
    {carouselImages.length > 1 && (
      <div class="absolute bottom-8 right-8 z-20 flex gap-2 items-center">
        {carouselImages.map((_, i) => (
          <button
            class="carousel-dot h-2 rounded-full transition-all duration-300"
            data-index={String(i)}
            style={i === 0 ? 'width:1.5rem;background:rgba(255,255,255,0.9)' : 'width:0.5rem;background:rgba(255,255,255,0.4)'}
            aria-label={`Bild ${i + 1}`}
          ></button>
        ))}
      </div>
    )}
  </div>

  <script>
    const slides = document.querySelectorAll<HTMLElement>('.carousel-slide')
    const dots = document.querySelectorAll<HTMLButtonElement>('.carousel-dot')
    if (slides.length > 1) {
      let current = 0
      let timer: ReturnType<typeof setInterval>

      function goTo(next: number) {
        slides[current].style.opacity = '0'
        if (dots[current]) {
          dots[current].style.width = '0.5rem'
          dots[current].style.background = 'rgba(255,255,255,0.4)'
        }
        current = next
        slides[current].style.opacity = '1'
        if (dots[current]) {
          dots[current].style.width = '1.5rem'
          dots[current].style.background = 'rgba(255,255,255,0.9)'
        }
      }

      function resetTimer() {
        clearInterval(timer)
        timer = setInterval(() => goTo((current + 1) % slides.length), 5000)
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => { goTo(i); resetTimer() })
      })

      timer = setInterval(() => goTo((current + 1) % slides.length), 5000)
    }
  </script>

  <!-- Properties -->
  <section class="max-w-5xl mx-auto px-6 py-16 border-t border-cream-border">
    <p class="text-xs uppercase tracking-widest text-ink-muted mb-3">Sex fastigheter i Skövde</p>
    <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-ink mb-10">Välskötta byggnader med karaktär</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredWithImages.map(({ property, heroImageUrl }) => <PropertyCard property={property} heroImageUrl={heroImageUrl} />)}
    </div>
    <div class="mt-10">
      <a href="/fastigheter" class="text-sm font-medium text-forest underline underline-offset-2 hover:opacity-70">
        Se alla fastigheter →
      </a>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-cream-dark py-20 mt-8">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-xs uppercase tracking-widest text-ink-muted mb-3">Hur vi tänker</p>
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-ink mb-12">Tre saker vi tror på som fastighetsägare</h2>
      <div class="grid sm:grid-cols-3 gap-10">
        {principles.map(p => (
          <div>
            <p class="text-3xl font-light text-cream-border mb-4">{p.num}</p>
            <h3 class="font-serif font-semibold text-ink mb-3">{p.title}</h3>
            <p class="text-ink-muted text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tenant values -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <p class="text-xs uppercase tracking-widest text-ink-muted mb-3">Att bo hos oss</p>
    <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-ink mb-12">
      Direkt kontakt.<br />Snabb hantering.<br />Inga mellanhänder.
    </h2>
    <div class="grid sm:grid-cols-2 gap-8">
      {tenantValues.map(v => (
        <div>
          <p class="font-medium text-ink mb-2">{v.title}</p>
          <p class="text-ink-muted text-sm leading-relaxed">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Quote -->
  <section class="bg-cream-dark py-20">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="font-serif text-2xl sm:text-3xl font-light text-ink italic max-w-xl mx-auto leading-snug">
        "Det ska kännas tryggt att bo hos oss."
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-ink mb-4">Intresserad av att bo hos oss?</h2>
    <p class="text-ink-muted max-w-prose mb-8 leading-relaxed">
      Lägenheter tillsätts snabbt och vi annonserar sällan. Skicka en intresseanmälan så hör vi av oss.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/kontakt" class="px-6 py-3 bg-forest text-white text-sm font-medium rounded hover:opacity-90 transition-opacity">
        Skicka intresseanmälan
      </a>
      <a href="/fastigheter" class="px-6 py-3 border border-cream-border text-ink text-sm font-medium rounded hover:border-ink-muted transition-colors">
        Se våra fastigheter
      </a>
    </div>
  </section>
</Layout>
