---
import Layout from '../layouts/Layout.astro'
import PropertyCard from '../components/PropertyCard.astro'
import { properties } from '../content/properties'
import { fetchPropertyImages, resolveImageUrl } from '../lib/images'

const featured = properties.slice(0, 3)

// Fetch hero image for each featured property at build time
const featuredWithImages = await Promise.all(
  featured.map(async p => {
    const images = await fetchPropertyImages(p.apiId)
    const hero = images[0] ? resolveImageUrl(images[0].url) : ''
    return { property: p, heroImageUrl: hero }
  })
)

const principles = [
  {
    num: '01',
    title: 'Bra hem',
    text: 'Vi vill att fastigheterna vi äger är platser där folk trivs och vill bo länge. Det innebär att vi tar hand om detaljerna — inte bara det som syns.',
  },
  {
    num: '02',
    title: 'Ta hand om det vi äger',
    text: 'Vi underhåller och förbättrar löpande, inte bara när något redan gått sönder. Det sparar resurser och gör att fastigheterna håller längre.',
  },
  {
    num: '03',
    title: 'Långsiktighet',
    text: 'Vi tänker i decennier, inte kvartal. Det påverkar hur vi investerar, vilka hantverkare vi väljer och hur vi behandlar de som bor hos oss.',
  },
]

const sustainability = [
  { title: 'Källsortering', text: 'Bra förutsättningar för sortering i alla fastigheter.' },
  { title: 'Vattenförbrukning', text: 'Löpande kontroll och snabb åtgärd av läckor.' },
  { title: 'Underhåll framför utbyte', text: 'Vi renoverar hellre än byter ut i onödan.' },
  { title: 'Lokala hantverkare', text: 'Vi väljer lokala leverantörer i Skövde när möjligt.' },
]

const tenantValues = [
  { title: 'Du når oss direkt', text: 'Inte via ett callcenter eller ett ärendesystem. Vi svarar på mail och telefon och känner till varje fastighet.' },
  { title: 'Felanmälningar hanteras snabbt', text: 'Vi anlitar ett fåtal pålitliga hantverkare i Skövde. Det gör att vi kan agera snabbt utan långa led.' },
  { title: 'Välskötta gemensamma ytor', text: 'Trapphus, tvättstugor och källare underhålls regelbundet. Det är en del av att ta ansvar för hela fastigheten.' },
  { title: 'Vi lyssnar', text: 'Om det är något som inte fungerar vill vi veta det. Inte för att det låter bra, utan för att vi faktiskt kan åtgärda det.' },
]
---

<Layout title="Välkommen">
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
    <p class="text-xs uppercase tracking-widest text-ink-muted mb-6">Skövde · Sedan 2010</p>
    <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold text-ink leading-tight max-w-2xl mb-8">
      Fastigheter vi själva vill vara stolta över.
    </h1>
    <p class="text-ink-muted text-lg max-w-xl mb-10 leading-relaxed">
      Vi äger och sköter sju fastigheter i Skövde. Personligt engagerade i varje byggnad, med blicken på lång sikt.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/fastigheter" class="px-6 py-3 bg-forest text-white text-sm font-medium rounded hover:opacity-90 transition-opacity">
        Våra fastigheter
      </a>
      <a href="/om-oss" class="px-6 py-3 border border-cream-border text-ink text-sm font-medium rounded hover:border-ink-muted transition-colors">
        Om oss
      </a>
    </div>
  </section>

  <!-- Properties -->
  <section class="max-w-5xl mx-auto px-6 py-16 border-t border-cream-border">
    <p class="text-xs uppercase tracking-widest text-ink-muted mb-3">Sju fastigheter i Skövde</p>
    <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-ink mb-10">Välskötta byggnader med karaktär</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredWithImages.map(({ property, heroImageUrl }) => <PropertyCard property={property} heroImageUrl={heroImageUrl} />)}
    </div>
    <div class="mt-10">
      <a href="/fastigheter" class="text-sm font-medium text-forest underline underline-offset-2 hover:opacity-70">
        Se alla fastigheter →
      </a>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-cream-dark py-20 mt-8">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-xs uppercase tracking-widest text-ink-muted mb-3">Hur vi tänker</p>
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-ink mb-12">Tre saker vi tror på som fastighetsägare</h2>
      <div class="grid sm:grid-cols-3 gap-10">
        {principles.map(p => (
          <div>
            <p class="text-3xl font-light text-cream-border mb-4">{p.num}</p>
            <h3 class="font-serif font-semibold text-ink mb-3">{p.title}</h3>
            <p class="text-ink-muted text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sustainability -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <p class="text-xs uppercase tracking-widest text-ink-muted mb-3">Hållbarhet börjar i vardagen</p>
    <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-ink max-w-xl mb-12">
      Många små, förnuftiga beslut skapar bättre fastigheter över tid.
    </h2>
    <p class="text-ink-muted max-w-prose mb-12 leading-relaxed">
      Vi har inga stora hållbarhetsmål att presentera. Men vi arbetar praktiskt och ansvarsfullt i det dagliga underhållet — och det gör skillnad på sikt.
    </p>
    <div class="grid sm:grid-cols-2 gap-8">
      {sustainability.map(s => (
        <div class="flex gap-4">
          <div class="w-8 h-8 rounded-full bg-forest-light border border-forest-ring flex-shrink-0 mt-0.5"></div>
          <div>
            <p class="font-medium text-ink mb-1">{s.title}</p>
            <p class="text-ink-muted text-sm">{s.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Team -->
  <section class="bg-ink text-cream py-20">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-xs uppercase tracking-widest text-ink-faint mb-3">Personerna bakom Sandhof</p>
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold mb-12 max-w-xl leading-snug">
        Vi är inte ett anonymt bolag — vi är ägarna, och vi är med i det dagliga arbetet.
      </h2>
      <div class="grid sm:grid-cols-2 gap-12">
        <div>
          <div class="w-12 h-12 rounded-full bg-ink-faint/40 flex items-center justify-center text-sm font-semibold text-ink-muted mb-4">AS</div>
          <p class="font-serif font-semibold text-cream">Anders Sandhof</p>
          <p class="text-xs uppercase tracking-widest text-ink-faint mt-1 mb-4">Grundare &amp; ägare</p>
          <blockquote class="text-ink-muted text-sm leading-relaxed italic mb-4">
            „Jag har alltid trott att en fastighet som sköts ordentligt är en fastighet folk vill bo kvar i. Det är lika mycket en fråga om respekt som om ekonomi.“
          </blockquote>
          <p class="text-ink-muted text-sm leading-relaxed">
            Anders grundade Sandhof 2010 och är involverad i den dagliga förvaltningen. Han känner varje fastighet inifrån och ut — bokstavligen.
          </p>
        </div>
        <div>
          <div class="w-12 h-12 rounded-full bg-ink-faint/40 flex items-center justify-center text-sm font-semibold text-ink-muted mb-4">MS</div>
          <p class="font-serif font-semibold text-cream">Maria Sandhof</p>
          <p class="text-xs uppercase tracking-widest text-ink-faint mt-1 mb-4">Ägare, ekonomi &amp; uthyrning</p>
          <blockquote class="text-ink-muted text-sm leading-relaxed italic mb-4">
            „Jag vill att de som bor hos oss ska känna att deras hem tas om hand. Det är det enklaste sättet att förklara vad vi gör.“
          </blockquote>
          <p class="text-ink-muted text-sm leading-relaxed">
            Maria ansvarar för ekonomi, hyresavtal och kontakten med hyresgäster. Tydlighet och tillgänglighet är hennes ledord.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tenant values -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <p class="text-xs uppercase tracking-widest text-ink-muted mb-3">Att bo hos oss</p>
    <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-ink mb-12">
      Direkt kontakt.<br />Snabb hantering.<br />Inga mellanhänder.
    </h2>
    <div class="grid sm:grid-cols-2 gap-8">
      {tenantValues.map(v => (
        <div>
          <p class="font-medium text-ink mb-2">{v.title}</p>
          <p class="text-ink-muted text-sm leading-relaxed">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Quote -->
  <section class="bg-cream-dark py-20">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="font-serif text-2xl sm:text-3xl font-light text-ink italic max-w-xl mx-auto leading-snug">
        „Det ska kännas tryggt att bo hos oss.“
      </p>
      <p class="mt-4 text-ink-muted text-sm">— Anders Sandhof</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-ink mb-4">Intresserad av att bo hos oss?</h2>
    <p class="text-ink-muted max-w-prose mb-8 leading-relaxed">
      Lägenheter tillsätts snabbt och vi annonserar sällan. Skicka en intresseanmälan så hör vi av oss.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/kontakt" class="px-6 py-3 bg-forest text-white text-sm font-medium rounded hover:opacity-90 transition-opacity">
        Skicka intresseanmälan
      </a>
      <a href="/fastigheter" class="px-6 py-3 border border-cream-border text-ink text-sm font-medium rounded hover:border-ink-muted transition-colors">
        Se våra fastigheter
      </a>
    </div>
  </section>
</Layout>
