---
const navLinks = [
  { href: '/fastigheter', label: 'Fastigheter' },
  { href: '/om-oss', label: 'Om oss' },
  { href: '/kontakt', label: 'Kontakt' },
]
const currentPath = Astro.url.pathname
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-stone-100">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-semibold text-stone-900 tracking-tight">
      Sandhof Fastigheter
    </a>
    <nav class="hidden sm:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`text-sm transition-colors ${
            currentPath.startsWith(link.href)
              ? 'text-stone-900 font-medium'
              : 'text-stone-500 hover:text-stone-900'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="sm:hidden p-2 text-stone-600"
      aria-label="Öppna meny"
    >
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-stone-100 bg-white">
    {navLinks.map(link => (
      <a href={link.href} class="block px-6 py-3 text-stone-700 hover:bg-stone-50">
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'))
</script>
