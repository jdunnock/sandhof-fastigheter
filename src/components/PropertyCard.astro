---
import type { RemoteProperty } from '../lib/images'

interface Props {
  property: RemoteProperty
  heroImageUrl?: string
}

const { property, heroImageUrl } = Astro.props
const imgSrc = heroImageUrl || '/images/placeholder-property.jpg'
---

<article class="group bg-cream-dark border border-cream-border rounded-lg overflow-hidden hover:shadow-md transition-shadow">
  <a href={`/fastigheter/${property.public_slug}`}>
    <div class="aspect-[4/3] bg-cream-border overflow-hidden">
      {imgSrc !== '/images/placeholder-property.jpg' ? (
        <img
          src={imgSrc}
          alt={property.name}
          class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <p class="text-ink-muted text-sm">Bilder på väg</p>
        </div>
      )}
    </div>
    <div class="p-5">
      <p class="text-xs uppercase tracking-widest text-ink-muted mb-1">
        {property.address}
      </p>
      <h3 class="font-serif font-semibold text-ink text-lg mb-2">{property.name}</h3>
      <p class="text-ink-muted text-sm leading-relaxed line-clamp-3">{property.public_description}</p>
      <span class="inline-block mt-4 text-sm font-medium text-forest underline underline-offset-2">
        Visa fastigheten →
      </span>
    </div>
  </a>
</article>
